{
  "manifest_version": 3,
  "name": "Britive",
  "version": "1.2.0",
  "version_name": "1.2.0",
  "description": "Britive extension for My Access, My Approvals, and My Secrets.",
  "icons": {
    "48": "icons/britive-icon-48.png",
    "96": "icons/britive-icon-96.png",
    "128": "icons/britive-icon-128.png"
  },
  "permissions": [
    "identity",
    "activeTab",
    "contextMenus",
    "storage",
    "notifications",
    "clipboardWrite",
    "scripting",
    "alarms",
    "declarativeNetRequest",
    "offscreen",
    "cookies"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*",
    "https://*.britive-app.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "autofill-prompt.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_icon": {
      "48": "icons/britive-icon-48.png",
      "96": "icons/britive-icon-96.png",
      "128": "icons/britive-icon-128.png"
    },
    "default_title": "Britive",
    "default_popup": "popup/popup.html"
  },
  "options_ui": {
    "page": "options/options.html"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/britive-icon-48.png"
      ],
      "matches": [
        "http://*/*",
        "https://*/*"
      ]
    }
  ],
  "commands": {
    "open-access-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open Britive extension and focus access search"
    },
    "open-approvals-tab": {
      "suggested_key": {
        "default": "Ctrl+Shift+Comma",
        "mac": "Command+Shift+Comma"
      },
      "description": "Open Britive extension and switch to approvals"
    },
    "open-secrets-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+Period",
        "mac": "Command+Shift+Period"
      },
      "description": "Open Britive extension and focus secrets search"
    },
    "autofill-password-manager": {
      "suggested_key": {
        "default": "Ctrl+Shift+L",
        "mac": "Command+Shift+L"
      },
      "description": "Autofill the best Britive match for the current page"
    }
  }
}
